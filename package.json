{
  "name": "palpocket",
  "version": "4.0.1",
  "description": "Palworld worker-pal overlay: which pals to get by level + base planner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "validate": "node scripts/validate.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "changelog": "node scripts/release.mjs --changelog-only",
    "release": "node scripts/release.mjs",
    "release:beta": "node scripts/release.mjs --beta"
  },
  "author": "Cloudjunkie-Tobias",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cloudjunkie-Tobias/PalPocket.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "com.tobias.palpocket",
    "productName": "PalPocket",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "PalPocket-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Cloudjunkie-Tobias",
      "repo": "PalPocket",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PalPocket",
      "artifactName": "PalPocket-Setup-${version}.exe",
      "uninstallDisplayName": "PalPocket ${version}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
